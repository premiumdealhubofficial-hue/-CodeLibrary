# =================================================================
# CodeLibrary - Environment Configuration Template
# =================================================================
# Copy this file to .env and fill in your actual production values:
#   cp .env.example .env
#
# DO NOT commit the .env file with real secrets to version control.
# =================================================================

# -----------------------------------------------------------------
# 1. SERVER & APPLICATION SETTINGS
# -----------------------------------------------------------------
# Port number for the Express application (default: 3000)
PORT=3000

# Environment mode: 'development' or 'production'
NODE_ENV=production

# Public base URL of your live website (e.g., https://codelibrary.in or https://yourdomain.com)
BASE_URL=https://codelibrary.in

# Trust upstream reverse proxy headers (e.g. Nginx, Cloudflare, AWS ALB, Render, Railway)
TRUST_PROXY=true

# -----------------------------------------------------------------
# 2. DATABASE PERSISTENCE
# -----------------------------------------------------------------
# Path to SQLite database file.
# For production on VPS: database.sqlite or /var/data/database.sqlite
# For containerized hosting (Docker/Render/Fly.io): Use a persistent volume mount path (e.g., /data/database.sqlite)
DB_PATH=database.sqlite

# -----------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT & COOKIES)
# -----------------------------------------------------------------
# Strong cryptographic secret key for signing JWT user & admin session cookies.
# Generate on Linux/Mac: openssl rand -base64 64
# Generate on Node: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_at_least_64_characters_long

# -----------------------------------------------------------------
# 4. INITIAL ADMIN SEED CREDENTIALS
# -----------------------------------------------------------------
# Used only during initial database seed (`npm run seed`) to create the primary admin.
ADMIN_EMAIL=admin@codelibrary.in
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SetAStrongAdminPasswordHere123!

# -----------------------------------------------------------------
# 5. RAZORPAY PAYMENT GATEWAY
# -----------------------------------------------------------------
# Get your API keys from Razorpay Dashboard (https://dashboard.razorpay.com/app/keys):
# - TEST Mode: Key starts with "rzp_test_..."
# - LIVE Mode: Key starts with "rzp_live_..."
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Webhook Secret configured in Razorpay Dashboard -> Settings -> Webhooks:
# Set Webhook URL: https://yourdomain.com/api/payment/webhook
# Active events: payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# -----------------------------------------------------------------
# 6. EBOOK & STORAGE CONFIGURATION
# -----------------------------------------------------------------
# Directory for local ebook storage (if storing local copies)
EBOOK_STORAGE_PATH=./ebooks

# Google Drive PDF URLs are managed dynamically through the Admin Panel:
# Navigate to Admin Panel -> Books -> Edit Book -> "Google Drive PDF Link"
# Links are securely verified and served directly to authorized buyers.

# -----------------------------------------------------------------
# 7. DATABASE BACKUP CONFIGURATION
# -----------------------------------------------------------------
# Directory where atomic SQLite backups are stored (outside public directory)
BACKUP_DIR=backups

# Number of rolling backups to retain before older ones are pruned
BACKUP_RETENTION_COUNT=30
